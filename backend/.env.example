# Copiar a .env y rellenar. NUNCA versionar el .env real.
#
# Un microservicio, un rol de Postgres, un schema. Cada URL apunta solo a lo
# que su servicio tiene derecho a ver.
#
# La contraseña va DENTRO de la URL: si tiene "/", "@" o ":" hay que
# percent-codificarla. Lo más simple es generarla en hexadecimal
# (openssl rand -hex 24) y no tener que pensarlo.

IDENTIDAD_DATABASE_URL="postgresql://identidad:cambiar-esta-clave@localhost:5432/mic?schema=identidad"
ENTRENAMIENTO_DATABASE_URL="postgresql://entrenamiento:cambiar-esta-clave@localhost:5432/mic?schema=entrenamiento"

# Claves ES256 de los JWT, cada PEM en base64 de una línea. Generar con
# `../scripts/generate-jwt-keys.sh >> .env`. En desarrollo los dos servicios
# leen este mismo archivo; en docker-compose cada uno recibe solo las suyas.
IDENTIDAD_JWT_PRIVATE_KEY=""
IDENTIDAD_JWT_PUBLIC_KEY=""
ENTRENAMIENTO_JWT_PRIVATE_KEY=""
ENTRENAMIENTO_JWT_PUBLIC_KEY=""

# Access token: vida corta, es lo único que autoriza cada petición.
JWT_EXPIRES_IN="15m"
# Refresh token: solo lo usa `identidad` (POST /api/auth/refresh); no aplica
# a `entrenamiento`, que nunca ve uno.
REFRESH_TOKEN_EXPIRES_IN="12h"

# Solo lo usa `identidad`. Ver la nota del .env.example de la raíz.
CEDULA_PEPPER="cambiar-por-un-secreto-largo-y-aleatorio"

# Base de la URL de verificación que imprime el certificado
# (".../verificar/SW-XXXX-XXXX"). Sin protocolo final duplicado ni barra al
# final. Opcional: sin ella, el certificado usa un valor por defecto.
CERTIFICADO_ORIGEN="https://xyz"

# Puerto del servicio que se arranque. En compose lo fija cada contenedor:
# identidad 3001, entrenamiento 3002.
PORT=3001

# Solo para `vite dev`. En producción el frontend va por el mismo origen.
CORS_ORIGINS="http://localhost:5173"

# Correo de confirmación de cuenta, recuperación de clave, y entrega del
# certificado (Resend). API key en resend.com/api-keys. Dominio verificado
# en resend.com/domains.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
MAIL_FROM="SAFE-Web <noreply@tudominio.xyz>"

# Voz del saludo personalizado y de la narración del contexto de cada
# escenario (issue #285). API key en play.cartesia.ai. Solo la usa
# `identidad`; `frontend/scripts/narracion.py` tiene su propia copia en
# frontend/.env para regenerar los clips de contexto.
CARTESIA_API_KEY="sk_car_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
