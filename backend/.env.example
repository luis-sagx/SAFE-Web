# Copiar a .env y rellenar. NUNCA versionar el .env real.
#
# Un microservicio, un rol de Postgres, un schema. Cada URL apunta solo a lo
# que su servicio tiene derecho a ver.
#
# La contraseña va DENTRO de la URL: si tiene "/", "@" o ":" hay que
# percent-codificarla. Lo más simple es generarla en hexadecimal
# (openssl rand -hex 24) y no tener que pensarlo.

IDENTIDAD_DATABASE_URL="postgresql://identidad:cambiar-esta-clave@localhost:5432/mic?schema=identidad"
ENTRENAMIENTO_DATABASE_URL="postgresql://entrenamiento:cambiar-esta-clave@localhost:5432/mic?schema=entrenamiento"

# Lo único que comparten los dos servicios: `identidad` firma el token y
# `entrenamiento` lo verifica, sin llamarse por red.
# Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Access token: vida corta, es lo único que autoriza cada petición.
JWT_EXPIRES_IN="15m"
# Refresh token: solo lo usa `identidad` (POST /api/auth/refresh); no aplica
# a `entrenamiento`, que nunca ve uno.
REFRESH_TOKEN_EXPIRES_IN="12h"

# Solo lo usa `identidad`. Ver la nota del .env.example de la raíz.
CEDULA_PEPPER="cambiar-por-otro-secreto-distinto-del-jwt"

# Puerto del servicio que se arranque. En compose lo fija cada contenedor:
# identidad 3001, entrenamiento 3002.
PORT=3001

# Solo para `vite dev`. En producción el frontend va por el mismo origen.
CORS_ORIGINS="http://localhost:5173"
