// Servicio de IDENTIDAD: el único que conoce datos personales.
//
// Regla de privacidad: nombre, correo y cédula sirven ÚNICAMENTE para que el
// participante entre a la plataforma con algo familiar. Nunca salen hacia el
// análisis — de hecho ya no pueden: las corridas viven en otro schema, con
// otro rol de base de datos, en un servicio que no tiene ningún modelo ni
// ningún permiso para leer esta tabla. Esa separación estructural es la que
// garantiza el anonimato del dato de análisis, no un borrado posterior.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/identidad"
}

// En Prisma 7 la URL de conexión no vive aquí: para migraciones se declara en
// prisma.identidad.config.ts y para el runtime se pasa al driver adapter.
datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  // Gestiona cuentas y ve los resultados seudonimizados dentro de la app. No
  // se llama ADMIN/ADMINISTRATOR a propósito: es el nombre que un atacante
  // busca primero.
  SUPERVISOR
}

model Participant {
  id String @id @default(uuid())

  /// Número de orden de registro. De aquí se deriva el seudónimo del análisis
  /// ("P001", "P002", …). Viaja en el JWT para que el servicio de
  /// entrenamiento pueda etiquetar cada corrida sin consultar este servicio.
  seq Int @unique @default(autoincrement())

  // --- Datos personales: solo para el acceso. Nunca se exportan. ---
  //
  // Cifrados en reposo (issue #95, ver apps/identidad/src/pii/pii.ts): lo que
  // vive en `nombre`, `apellido` y `email` es AES-256-GCM, no texto plano.
  // La aplicación cifra al escribir y descifra al leer con
  // PII_ENCRYPTION_KEY (.env); alguien que se lleve solo el volumen de
  // Postgres —un backup, un dump— no puede leerlos.
  //
  // Una fila creada antes de este cambio, si todavía no pasó por
  // `backfill-pii.mts`, guarda estos tres campos en texto plano: `descifrar()`
  // lo reconoce por la falta del prefijo "v1:" y lo devuelve tal cual, así
  // que sigue siendo legible mientras el backfill no ha corrido. Es
  // deliberado, no un descuido: evita una ventana de login roto entre
  // desplegar este cambio de esquema y correr el script.
  nombre   String
  apellido String
  email    String

  /// HMAC-SHA256(correo normalizado, EMAIL_PEPPER): el índice único para
  /// encontrar la cuenta al iniciar sesión, ahora que `email` guarda texto
  /// cifrado (con IV aleatorio, así que el mismo correo nunca cifra igual dos
  /// veces y no podría servir de índice por sí solo). Mismo patrón que
  /// `cedulaHash`, con su propio secreto: un pepper por tipo de dato, para
  /// que la filtración de uno no arrastre al otro.
  ///
  /// Nullable en vez de exigirlo desde ya: una fila sin migrar todavía no
  /// tiene huella, y `login()` cae a buscar por el `email` en claro de esas
  /// filas mientras tanto (ver auth.service.ts). Se puede volver obligatorio
  /// en una migración futura, una vez que `backfill-pii.mts` corrió en todos
  /// los entornos.
  emailHash String? @unique

  /// HMAC-SHA256(cédula, CEDULA_PEPPER). La cédula EN CLARO NUNCA SE GUARDA:
  /// no entra a la base, no sale en ninguna respuesta y no va a los logs.
  ///
  /// Su única función es garantizar una cuenta por persona. Se usa HMAC y no
  /// un hash simple porque el espacio de cédulas son 10 dígitos y un SHA-256
  /// sin secreto se invierte por fuerza bruta en segundos; el pepper es lo que
  /// lo hace irreversible. Y no bcrypt, porque para servir de índice único
  /// tiene que ser determinista.
  ///
  /// Nullable: la cuenta de supervisor (creada por `pnpm seed`) no tiene
  /// cédula, no es participante del estudio.
  cedulaHash String? @unique

  passwordHash String
  role         Role   @default(PARTICIPANT)

  /// Si ya vio la pantalla de bienvenida y no quiere que vuelva a aparecer.
  /// Null = nunca la vio, o pidió verla de nuevo; con fecha = la vio y la
  /// cerró marcando "no volver a mostrar".
  onboardingVistoAt DateTime?

  /// Cuenta desactivada por un supervisor. Null = activa. Una cuenta desactivada
  /// no puede iniciar sesión; un token ya emitido caduca por su cuenta (JWT
  /// corto), no se revoca al instante entre servicios.
  disabledAt DateTime?

  createdAt DateTime @default(now())
}

/// Certificado de las 4 horas del entrenamiento. Se emite al canjear una
/// atestación firmada por `entrenamiento` (spec 2026-09-03 §5): este servicio
/// nunca consulta el progreso por su cuenta, solo verifica lo que el
/// participante trae firmado.
///
/// La calificación total llega firmada desde `entrenamiento`; se guarda aquí
/// solo para que el PDF conserve exactamente lo que acreditó al emitirse.
model Certificate {
  id String @id @default(uuid())

  /// Único: un certificado por persona. `POST /api/certificados` es
  /// idempotente sobre este campo (ver §5.4.1 del diseño).
  participantId String @unique

  /// Aleatorio, sin relación con `seq` ni con ningún dato personal: derivarlo
  /// filtraría el orden de registro o el número de participantes a quien
  /// reúna dos códigos. Formato "SW-XXXX-XXXX", alfabeto sin caracteres
  /// ambiguos (sin O/0, sin I/1).
  codigo String @unique

  /// Los módulos que la atestación cubría al emitirse o al último recorrido
  /// mayor. Es lo que evita que un certificado de cinco módulos y uno de seis
  /// digan lo mismo el día que crezca UMBRALES.
  modulos String[]

  /// Constante hoy (`HORAS_CERTIFICADO`), guardada y no recalculada: un
  /// certificado ya emitido no debe cambiar si el número cambia después.
  horas Int @default(4)

  /// Últimos resultados CORRECTO del participante, sobre los 48 escenarios
  /// que componen los seis módulos del certificado.
  calificacion Int @default(0)

  emitidoAt DateTime @default(now())

  /// Solo lo pone un supervisor (retiro de consentimiento, incidencia). No
  /// existe revocación automática por bajar de umbral: `identidad` no tiene
  /// forma de enterarse sin llamar a `entrenamiento`, y eso rompería la regla
  /// de que los servicios no se llaman entre sí (§5.3 del diseño).
  revocadoAt DateTime?

  /// Cuándo se mandó por correo. Null = nunca (correo sin verificar, envío
  /// fallido, o certificado emitido antes de existir este campo). Evita
  /// reenviarlo en cada re-emisión idempotente de `emitir()`.
  certificadoEnviadoAt DateTime?
}
