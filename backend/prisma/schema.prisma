// Modelo de datos de la plataforma de entrenamiento anti-fraude.
//
// Regla de privacidad (NIST SP 800-188): los datos personales del participante
// (nombre, correo, teléfono) sirven ÚNICAMENTE para que entre a la plataforma
// con algo familiar. Nunca salen hacia el análisis: la exportación identifica
// cada fila por el seudónimo derivado de `seq` (P01, P02, …), que el
// participante ni siquiera ve.
//
// Al cerrar la recolección se ejecuta `pnpm anonimizar`, que borra nombre,
// correo y teléfono dejando intactas las corridas. Ahí la pseudonimización
// pasa a ser anonimización real e irreversible.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// En Prisma 7 la URL de conexión no vive aquí: para migraciones se declara en
// prisma.config.ts y para el runtime se pasa al driver adapter en PrismaService.
datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  RESEARCHER
}

/// Resultado pedagógico de una corrida. Los tres valores corresponden a los
/// tres finales que define el diseño de escenarios: lo evitó verificando /
/// dudó pero cayó / cayó. En los escenarios legítimos el mapeo es el mismo,
/// pero el final incorrecto es la desconfianza excesiva.
enum RunOutcome {
  CORRECTO
  PARCIAL
  INCORRECTO
}

model Participant {
  id String @id @default(uuid())

  /// Número de orden de registro. De aquí se deriva el seudónimo del análisis
  /// ("P01", "P02", …). Es autoincremental para que dos registros simultáneos
  /// no puedan recibir el mismo seudónimo.
  seq Int @unique @default(autoincrement())

  // --- Datos personales: solo para el acceso. Nunca se exportan. ---
  // Son nullables porque `pnpm anonimizar` los pone en null al cerrar la
  // recolección de datos.
  nombre   String?
  email    String  @unique
  telefono String?

  passwordHash String
  role         Role  @default(PARTICIPANT)

  /// Grupo de la muestra (ej. "adultos-mayores", "comerciantes"). Opcional.
  cohort String?

  /// Marca de cuándo se borraron los datos personales. Deja constancia de que
  /// la anonimización se aplicó, sin guardar qué se borró.
  anonymizedAt DateTime?

  createdAt DateTime @default(now())

  runs ScenarioRun[]
}

model ScenarioRun {
  id String @id @default(uuid())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  /// Identificador del escenario en el catálogo del frontend, con el formato
  /// "<seccionId>/<escenarioId>" (ej. "smishing/cambio-numero").
  scenarioId String
  /// Versión del contenido del escenario. Se sube al editar el guion para no
  /// mezclar corridas de versiones distintas en el análisis estadístico.
  version    Int    @default(1)

  outcome    RunOutcome
  /// Puntaje 0–100 calculado por el frontend según el final alcanzado.
  score      Int
  /// Id del nodo final alcanzado dentro del grafo del escenario (ej. "e_pago").
  endingId   String
  durationMs Int

  /// Traza libre de la corrida (nodos visitados, señales descubiertas,
  /// tiempos por decisión). Cada escenario define su propia forma; JSONB
  /// permite guardarlas sin una tabla distinta por tipo de escenario.
  decisions Json @default("[]")

  startedAt  DateTime
  finishedAt DateTime @default(now())

  @@index([participantId, scenarioId])
  @@index([scenarioId])
}
