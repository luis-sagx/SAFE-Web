# Variables de docker compose. Copiar a .env y rellenar.
# El archivo .env real NUNCA se versiona.

POSTGRES_USER=mic
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=mic

# Un rol de base de datos por microservicio, cada uno dueño de su schema y sin
# permisos sobre el del otro. Es lo que impide que el servicio del estudio
# alcance los datos personales, incluso con SQL crudo.
# Generar cada una con: openssl rand -base64 24
IDENTIDAD_DB_PASSWORD=cambiar-esta-clave-de-identidad
ENTRENAMIENTO_DB_PASSWORD=cambiar-esta-clave-de-entrenamiento

# Lo único que comparten los dos servicios: uno firma el token y el otro lo
# verifica, sin llamarse por red.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Puerto del servidor propio donde queda publicada la plataforma.
WEB_PORT=80
