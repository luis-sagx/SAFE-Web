# Variables de docker compose. Copiar a .env y rellenar.
# El archivo .env real NUNCA se versiona.

POSTGRES_USER=mic
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=mic

# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Puerto del servidor propio donde queda publicada la plataforma.
WEB_PORT=80
