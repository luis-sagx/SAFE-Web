# Variables de docker compose. Copiar a .env y rellenar.
# El archivo .env real NUNCA se versiona.

POSTGRES_USER=mic
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=mic

# Un rol de base de datos por microservicio, cada uno dueño de su schema y sin
# permisos sobre el del otro. Es lo que impide que el servicio del estudio
# alcance los datos personales, incluso con SQL crudo.
#
# LAS TRES CONTRASEÑAS DE BASE DE DATOS, EN HEXADECIMAL Y NO EN BASE64: se
# incrustan en una URL de conexión (postgresql://usuario:CLAVE@db:5432/…), y
# un "/" o un "@" de base64 la parten. El síntoma es un error de Prisma que no
# se parece en nada a la causa: "P1013: invalid port number in database URL".
# Generar cada una con: openssl rand -hex 24
IDENTIDAD_DB_PASSWORD=cambiar-esta-clave-de-identidad
ENTRENAMIENTO_DB_PASSWORD=cambiar-esta-clave-de-entrenamiento

# Lo único que comparten los dos servicios: uno firma el token y el otro lo
# verifica, sin llamarse por red.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Access token: vida corta (OWASP), es lo único que autoriza cada petición.
JWT_EXPIRES_IN=15m
# Refresh token: solo lo ve `identidad` (POST /api/auth/refresh). Vida más
# larga para que una sesión de estudio (varios escenarios seguidos) no obligue
# a volver a loguear cada pocos minutos.
REFRESH_TOKEN_EXPIRES_IN=12h

# Secreto con el que se calcula la huella de la cédula. Sin él, esas huellas se
# invertirían por fuerza bruta: son solo 10 dígitos.
# Generar con: openssl rand -base64 48
CEDULA_PEPPER=cambiar-por-otro-secreto-distinto-del-jwt

# Puerto del servidor propio donde queda publicada la plataforma.
WEB_PORT=80
